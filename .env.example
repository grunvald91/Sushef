# НИКОГДА не коммитьте настоящие токены или пароли.
TELEGRAM_BOT_TOKEN=123456789:replace_with_token_from_botfather
CLAUDEHUB_API_KEY=sk-hub-replace_with_your_key
CLAUDEHUB_BASE_URL=https://api.claudehub.fun
# Смените по списку доступных моделей в своём кабинете ClaudeHub.
CLAUDEHUB_MODEL=claude-opus-4-7
DATABASE_URL=sqlite+aiosqlite:///./sushef.db
# Для Docker Compose используйте случайный длинный пароль из латинских букв и цифр.
# Если пароль содержит символы URL (@, :, /, #), его нужно URL-кодировать для DATABASE_URL.
POSTGRES_PASSWORD=replace_with_long_random_alphanumeric_password
MAX_OUTPUT_TOKENS=1300
DAILY_AI_LIMIT=25
MAX_INPUT_CHARS=3500
# Пока не подтверждена поддержка изображений моделью через ClaudeHub — выключено.
VISION_ENABLED=false
MAX_PHOTO_BYTES=4000000

# Optional HTTP/SOCKS proxy for Telegram; leave empty for direct TLS access.
TELEGRAM_PROXY_URL=
